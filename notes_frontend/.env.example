# Frontend environment variables for Personal Notes (React)
# Do not commit real secrets. Copy this file to .env and adjust as needed.

# Optional: REST API base URL. If not set, app uses localStorage for persistence.
REACT_APP_API_BASE=
# Optional alternative backend URL variable name
REACT_APP_BACKEND_URL=

# Optional: Frontend URL (used for redirects if integrating external auth)
REACT_APP_FRONTEND_URL=

# Optional: Websocket URL if a real-time backend is added later
REACT_APP_WS_URL=

# Feature flags can be JSON or a comma separated list, e.g.:
# REACT_APP_FEATURE_FLAGS='{"showTags":true,"betaToolbar":false}'
# or
# REACT_APP_FEATURE_FLAGS=showTags,betaToolbar
REACT_APP_FEATURE_FLAGS=

# Other optional runtime settings
REACT_APP_NODE_ENV=development
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health

# CRA runs on 3000 by default. To change:
# PORT=3000
